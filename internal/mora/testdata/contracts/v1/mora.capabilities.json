  "error_codes": [
    {
      "class": "connector",
      "code": "connector.empty",
      "error_class": "empty",
      "exit_code": 1,
      "meaning": "A source was read successfully and returned zero items — distinct from fresh-with-data and from failed. Defined here; emitted on a live per-source receipt in Phase 2 (ISO-02).",
      "retryable": false
    },
    {
      "class": "connector",
      "code": "connector.malformed_response",
      "error_class": "malformed",
      "exit_code": 1,
      "meaning": "A connector process, API, or local database returned a payload Mora could not parse. Retrying the same request reproduces it.",
      "retryable": false
    },
    {
      "class": "connector",
      "code": "connector.stale",
      "error_class": "stale",
      "exit_code": 1,
      "meaning": "A source last succeeded longer ago than its freshness budget allows. The data on hand is real but old.",
      "retryable": true
    },
    {
      "class": "connector",
      "code": "connector.unauthorized",
      "error_class": "unauthorized",
      "exit_code": 1,
      "meaning": "A connector was refused by an authentication or permission failure Mora DIRECTLY OBSERVED — an expired token, a refused credential. Never an inference from an error string.",
      "retryable": false
    },
    {
      "class": "connector",
      "code": "connector.unavailable",
      "error_class": "unavailable",
      "exit_code": 1,
      "meaning": "A connector's process, binary, database, or network endpoint could not be reached.",
      "retryable": true
    },
    {
      "class": "connector",
      "code": "connector.unclassified",
      "error_class": "unclassified",
      "exit_code": 1,
      "meaning": "A connector failure with no typed cause. Also the read-time backfill value for every sync record persisted before this taxonomy shipped: an empty error_code beside a non-empty last_error reads as unclassified rather than as success.",
      "retryable": false
    },
    {
      "class": "consent",
      "code": "consent.required",
      "error_class": "",
      "exit_code": 1,
      "meaning": "An operation needs an explicit local consent that is not enabled. Producer: `mora teach examples`, which refuses until `mora teach consent enable --yes` records consent.",
      "retryable": false
    },
    {
      "class": "data",
      "code": "data.corrupt",
      "error_class": "",
      "exit_code": 1,
      "meaning": "A vault or state file exists but could not be decoded.",
      "retryable": false
    },
    {
      "class": "data",
      "code": "data.not_found",
      "error_class": "",
      "exit_code": 1,
      "meaning": "A requested memory, entity, or record does not exist.",
      "retryable": false
    },
    {
      "class": "index",
      "code": "index.schema_mismatch",
      "error_class": "",
      "exit_code": 1,
      "meaning": "The index database exists but its tables or columns do not match what this build expects.",
      "retryable": false
    },
    {
      "class": "index",
      "code": "index.unavailable",
      "error_class": "",
      "exit_code": 1,
      "meaning": "The search index database could not be opened. The vault is intact; `mora index rebuild` is the repair.",
      "retryable": true
    },
    {
      "class": "internal",
      "code": "internal.unexpected",
      "error_class": "",
      "exit_code": 1,
      "meaning": "A failure Mora could not attribute to the caller, a connector, or the data. A Mora bug; report it.",
      "retryable": false
    },
    {
      "class": "usage",
      "code": "usage.missing_argument",
      "error_class": "",
      "exit_code": 1,
      "meaning": "A required positional argument was absent.",
      "retryable": false
    },
    {
      "class": "usage",
      "code": "usage.unknown_flag",
      "error_class": "",
      "exit_code": 1,
      "meaning": "An unknown or malformed flag was passed to a command.",
      "retryable": false
    },
    {
      "class": "usage",
      "code": "usage.unknown_value",
      "error_class": "",
      "exit_code": 1,
      "meaning": "A flag or positional argument carried a value the command does not accept.",
      "retryable": false
    }
  ],
  "exit_codes": {
    "allocated": [
      {
        "code": 1,
        "meaning": "Generic failure. Every error class maps here today, including `doctor --strict` on an unhealthy report.",
        "status": "grandfathered"
      },
      {
        "code": 10,
        "meaning": "`loop begin`: this period already succeeded. The idempotent skip, distinct from a real failure.",
        "status": "grandfathered"
      },
      {
        "code": 2,
        "meaning": "`doctor --pulse`: a source, the index, or a producer is unhealthy. Sick, not broken.",
        "status": "grandfathered"
      }
    ],
    "first_allocatable": 11,
    "reserved": {
      "from": 3,
      "reason": "Low single-digit statuses are widely squatted by shells, test runners, and wrapper scripts. Leaving 3 through 9 permanently unallocated means a future Mora code can never be confused with one of those conventions.",
      "status": "permanently reserved-unused",
      "to": 9
    }
  },
