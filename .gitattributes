# Golden test fixtures are compared byte-for-byte against renderer output, which
# always emits LF. Force LF at checkout on every OS so a Windows clone with
# core.autocrlf=true does not rewrite them to CRLF and break the comparison.
# (These are the only *.golden files in the repo today.)
*.golden text eol=lf

# Frozen-incident fixtures are replayed as Mora vault input. The Markdown
# parser's frontmatter delimiter and the rendered scorer artifact are LF-byte
# contracts, so Git must not rewrite this tree under core.autocrlf on Windows.
internal/mora/eval/** text eol=lf

# The real-output pin is also compared as raw bytes against json.MarshalIndent,
# which emits LF on every platform. Keep Windows checkout conversion out of it.
internal/mora/exam/testdata/** text eol=lf

# Contract baseline fixtures are compared byte-for-byte against json.MarshalIndent
# output. Keep checkout conversion from producing Windows-only baseline drift.
internal/mora/testdata/contracts/*.json text eol=lf

# The frozen v1 contract corpus sits one directory deeper, and `*` does not
# cross a separator, so the rule above never reached it. windows-latest runs the
# full suite and a CRLF golden fails the byte compare.
internal/mora/testdata/contracts/**/*.json text eol=lf

# The companion contract corpus is compared byte-for-byte against
# json.MarshalIndent output, which emits LF everywhere. Windows checkout
# conversion would rewrite these to CRLF and fail every golden.
internal/companion/testdata/v1/*.json text eol=lf
